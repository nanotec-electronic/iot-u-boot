/* SPDX-License-Identifier: GPL-2.0+ */

/*
 * Environment for Raspberry Pi boards — Ubuntu Core Secure Boot variant.
 *
 * All boot logic is compiled into the U-Boot binary to eliminate the
 * unverified boot.scr attack surface. Follows the NXP/iot-field reference
 * adapted for BCM2712 (Pi 5) with split-bootm workaround.
 *
 * Selected by CONFIG_ENV_SOURCE_FILE="rpi-uc" in the v2 defconfig.
 * The original rpi.env (distro boot) is preserved for the v1 defconfig.
 */

/* Environment — headless: serial only, no vidconsole */
stdin=serial
stdout=serial
stderr=serial

/* DFU over USB/UDC */
#ifdef CONFIG_CMD_DFU
dfu_alt_info=u-boot.bin fat 0 1;uboot.env fat 0 1;
  config.txt fat 0 1;
#ifdef CONFIG_ARM64
dfu_alt_info+=Image fat 0 1
#else
dfu_alt_info+=zImage fat 0 1
#endif
#endif  /* CONFIG_CMD_DFU */

/*
 * Memory layout — same as upstream rpi.env.
 * See rpi.env for detailed comments on address allocation.
 */
bootm_size=0x20000000

kernel_addr_r=0x00080000
kernel_comp_addr_r=0x02000000
kernel_comp_size=0x03400000
scriptaddr=0x05400000
pxefile_addr_r=0x05500000
fdt_addr_r=0x05600000
ramdisk_addr_r=0x05700000

/*
 * --- Ubuntu Core Secure Boot Flow ---
 *
 * Flow: BOOTCOMMAND="run boot_uc"
 *   -> boot_uc: run load_uc; verify FIT; split-bootm; booti
 *   -> load_uc: snapd boot.sel protocol + A/B kernel state machine
 *
 * scriptaddr is reused as temporary buffer for boot.sel import/export.
 * fit_addr (0x30000000) holds the FIT image — well clear of kernel at 0x200000.
 * fdt_addr is set by Pi firmware (passed to U-Boot via DTB), NOT loaded by us.
 */

/* Partition mapping */
mmc_seed_part=1
mmc_boot_part=2
devtype=mmc
devnum=0

/* Snapd protocol variables */
kernel_filename=kernel.img
core_state=uboot/ubuntu/boot.sel
kernel_vars=snap_kernel snap_try_kernel kernel_status
recovery_vars=snapd_recovery_mode snapd_recovery_system snapd_recovery_kernel
snapd_recovery_mode=install

/* Kernel cmdline — hardcoded because U-Boot secure boot does not read
 * cmdline.txt from boot.img. All kernel parameters must be set here.
 * TODO(production): remove console= parameter entirely (no serial console
 *   in production — security risk).
 *
 * console=ttyAMA0 is the RP1 PL011 on GPIO14/15 — the carrier's serial
 * header, and the only UART both sample boards bring out. It is NOT the
 * CM5's dedicated debug UART: that is ttyAMA10 on module pads 35/36 (AON
 * GPIO 213/214), which the B-sample carrier does not break out. Pointing
 * console= there is what left the B-sample silent after "Device tree loaded".
 *
 * It must be the ttyAMAn name, not the serial0 alias. console_setup() splits
 * "serial0" into name="serial" idx=0 and matches it against driver-registered
 * console names; PL011 registers "ttyAMA", so "serial" never matches. Worse,
 * it fails closed: any console= sets console_set_on_cmdline, and
 * of_console_check() then skips the /chosen/stdout-path fallback, so the
 * kernel registers no console at all (/proc/consoles empty). Raspberry Pi OS
 * gets away with console=serial0 only because the FIRMWARE substitutes the
 * alias while processing cmdline.txt — here the cmdline is compiled into
 * u-boot.bin and the firmware never sees it.
 *
 * RP1 sits behind enumerated PCIe, so ttyAMA0 probes late (~1.16 s). That is
 * handled by the standard deferred-console path with full log replay; no
 * earlycon is possible for RP1, and none is needed.
 *
 * U-Boot's OWN output does not appear here. U-Boot resolves its console from
 * /chosen/stdout-path -> serial10 -> the SoC PL011 on the module pads, and it
 * has no RP1 driver and never brings up PCIe. That silence is structural, not
 * a misconfiguration. */
/*
 * NANOTEC_PRODUCTION is defined by the gadget's build-boot-img.sh when it is
 * invoked with PRODUCTION=1. It drops console= entirely, so the kernel emits
 * nothing on the carrier's serial header.
 *
 * Dropping console= re-enables the /chosen/stdout-path fallback (any console=
 * sets console_set_on_cmdline, which makes of_console_check() skip it). On this
 * platform stdout-path is a static serial10 in bcm2712-rpi.dtsi -- the CM5 debug
 * UART on module pads 35/36, which no carrier breaks out. So the kernel console
 * lands on pads nobody can reach without soldering to the module. That is the
 * intended production behaviour, not an oversight; see README-uc-secureboot.md.
 */
#ifdef NANOTEC_PRODUCTION
kernel_cmdline=panic=-1 video=HDMI-A-1:d video=HDMI-A-2:d
#else
kernel_cmdline=panic=-1 console=ttyAMA0,115200 video=HDMI-A-1:d video=HDMI-A-2:d
#endif

/* FIT load address — must not collide with kernel at 0x200000 or fdt_addr */
fit_addr=0x30000000

/*
 * load_uc: Full snapd boot.sel protocol with A/B kernel state machine.
 *
 * 1. Load boot.sel from ubuntu-seed, import recovery vars
 * 2. If run mode: load boot.sel from ubuntu-boot, handle A/B kernel switching
 *    (try -> trying -> clear), write back kernel_status, set kernel prefix
 * 3. If install/recovery: set kernel prefix from recovery system
 * 4. Set bootargs and call loadfiles
 *
 * Uses env import -v -c: -c = checksum format (boot.sel is mkenvimage output),
 * -v = validate (reject values with whitespace to prevent injection).
 * Variable whitelist (${recovery_vars} / ${kernel_vars}) limits what gets imported.
 */
load_uc=
  setenv kernel_bootpart ${mmc_seed_part};
  load ${devtype} ${devnum}:${kernel_bootpart} ${scriptaddr} ${core_state};
  env import -v -c ${scriptaddr} ${filesize} ${recovery_vars};
  if test ${snapd_recovery_mode} = run; then
    setenv bootargs "snapd_recovery_mode=${snapd_recovery_mode} ${kernel_cmdline}";
    setenv kernel_bootpart ${mmc_boot_part};
    load ${devtype} ${devnum}:${kernel_bootpart} ${scriptaddr} ${core_state};
    env import -v -c ${scriptaddr} ${filesize} ${kernel_vars};
    setenv kernel_name ${snap_kernel};
    if test -n ${kernel_status}; then
      if test ${kernel_status} = try; then
        if test -n ${snap_try_kernel}; then
          setenv kernel_status trying;
          setenv kernel_name ${snap_try_kernel};
        fi;
      elif test ${kernel_status} = trying; then
        setenv kernel_status;
      fi;
      env export -c ${scriptaddr} ${kernel_vars};
      save ${devtype} ${devnum}:${kernel_bootpart} ${scriptaddr} ${core_state} ${filesize};
    fi;
    setenv prefix uboot/ubuntu/${kernel_name}/;
  else
    setenv bootargs "snapd_recovery_mode=${snapd_recovery_mode} snapd_recovery_system=${snapd_recovery_system} ${kernel_cmdline}";
    setenv prefix systems/${snapd_recovery_system}/kernel/;
  fi;
  run loadfiles

/* loadfiles: Load signed FIT image from the determined kernel path */
loadfiles=load ${devtype} ${devnum}:${kernel_bootpart} ${fit_addr}
  ${prefix}${kernel_filename}

/*
 * boot_uc: Entry point called by CONFIG_BOOTCOMMAND="run boot_uc"
 *
 * BCM2712 split-bootm workaround: plain 'bootm' hangs on this SoC.
 * Must use: bootm start (parse FIT + verify sig) -> bootm loados (extract
 * kernel to load address 0x200000) -> bootm ramdisk (set initrd_start/end
 * env vars) -> booti (boot ARM64 kernel directly).
 *
 * bootm ramdisk sets initrd_start and initrd_end (NOT ramdisk_addr_r/size),
 * so we calculate ramdisk_size = initrd_end - initrd_start for booti.
 *
 * fdt_addr is provided by Pi firmware — NOT from FIT, NOT loaded by U-Boot.
 */
boot_uc=
  run load_uc;
  echo Verifying FIT signature...;
  bootm start ${fit_addr}#standard;
  if test $? -ne 0; then
    echo FATAL: FIT signature verification failed;
    reset;
  fi;
  bootm loados;
  bootm ramdisk;
  setexpr ramdisk_size ${initrd_end} - ${initrd_start};
  echo Booting verified kernel...;
  booti 0x200000 ${initrd_start}:${ramdisk_size} ${fdt_addr}
